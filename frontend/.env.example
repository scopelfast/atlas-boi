NEXT_PUBLIC_API_URL=http://localhost:3004
# Frontend dev/prod (npm run dev | start) usa porta 3000 — ver package.json
#
# Acesso externo (testador fora da rede):
#   1) backend:  cd backend && npm run dev
#   2) frontend: cd frontend && npm run dev
#   3) na raiz: npm install && npm run tunnel
#   Envie a URL https://....loca.lt ao testador (login: admin@atlas.local / admin123)
#   Opcional ngrok: ngrok config add-authtoken TOKEN && set TUNNEL_TOOL=ngrok && npm run tunnel
