generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ SAAS CORE ============

model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  cnpj      String?  @unique
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyPlans  CompanyPlan[]
  users         User[]
  userCompanies UserCompany[]
  roles         Role[]
  clientes      Cliente[]
  rotas         Rota[]
  motoristas    Motorista[]
  veiculos      Veiculo[]
  carregamentos Carregamento[]
  notasFiscais  CarregamentoNotaFiscal[]
  lancamentos   LancamentoFinanceiro[]
  carregamentoFotos CarregamentoFoto[]
  pushSubscriptions PushSubscription[]
}

model CompanyPlan {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([companyId, planId])
}

model Plan {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  price       Decimal? @db.Decimal(10, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companies       Company[]
  companyPlans    CompanyPlan[]
  planModules     PlanModule[]
  planModuleFuncs PlanModuleFunction[]
}

model Module {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  planModules     PlanModule[]
  planModuleFuncs PlanModuleFunction[]
  rolePermissions RolePermission[]
}

model Function {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planModuleFuncs PlanModuleFunction[]
  rolePermissions RolePermission[]
}

model PlanModule {
  id        String   @id @default(cuid())
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([planId, moduleId])
}

model PlanModuleFunction {
  id         String   @id @default(cuid())
  planId     String
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  moduleId   String
  module     Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  functionId String
  function   Function @relation(fields: [functionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([planId, moduleId, functionId])
}

model Role {
  id        String   @id @default(cuid())
  name      String
  slug      String
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  userCompanies   UserCompany[]
  rolePermissions RolePermission[]

  @@unique([slug, companyId])
}

model RolePermission {
  id         String   @id @default(cuid())
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  moduleId   String
  module     Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  functionId String
  function   Function @relation(fields: [functionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([roleId, moduleId, functionId])
}

model User {
  id        String   @id @default(cuid())
  email     String
  password  String
  name      String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  logs      Log[]
  carregamentoEventos CarregamentoEvento[]
  lancamentosCriados  LancamentoFinanceiro[]

  userCompanies UserCompany[]

  @@unique([email, companyId])
}

model UserCompany {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
}

// ============ OPERACIONAL (multi-tenant) ============

enum ClienteTipo {
  EMBARQUE
  DESEMBARQUE
  AMBOS
}

enum DocumentoTipo {
  CPF
  CNPJ
}

enum TipoVeiculo {
  CAMINHAO
  CARRETA
  JULIETA
  TOCO
  OUTRO
}

enum TipoComissao {
  POR_KM
  PERCENTUAL_CARGA
  VALOR_FIXO
  MISTO
}

model Cliente {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  tipoDocumento DocumentoTipo
  documento     String
  nome          String
  nomeFantasia  String?

  cep           String?
  logradouro    String?
  numero        String?
  complemento   String?
  bairro        String?
  cidade        String
  uf            String        @db.Char(2)
  codigoIbge    String?
  localChave    String

  latitude      Decimal?      @db.Decimal(10, 7)
  longitude     Decimal?      @db.Decimal(10, 7)

  tipo          ClienteTipo   @default(AMBOS)
  ativo         Boolean       @default(true)

  rotasOrigem   Rota[]        @relation("RotaOrigem")
  rotasDestino  Rota[]        @relation("RotaDestino")
  carregamentosOrigem  Carregamento[] @relation("CarregamentoOrigem")
  carregamentosDestino Carregamento[] @relation("CarregamentoDestino")
  lancamentos          LancamentoFinanceiro[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([companyId, documento, localChave])
  @@index([companyId, tipo])
  @@index([companyId, documento])
  @@index([companyId, cidade, uf])
}

model Rota {
  id                      String   @id @default(cuid())
  companyId               String
  company                 Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  codigo                  String
  descricao               String

  clienteOrigemId         String?
  clienteOrigem           Cliente? @relation("RotaOrigem", fields: [clienteOrigemId], references: [id])
  clienteDestinoId        String?
  clienteDestino          Cliente? @relation("RotaDestino", fields: [clienteDestinoId], references: [id])

  origemTexto             String?
  destinoTexto            String?

  distanciaKm             Decimal  @db.Decimal(10, 2)

  valorPedagio            Decimal  @default(0) @db.Decimal(12, 2)
  valorBalanca            Decimal  @default(0) @db.Decimal(12, 2)
  valorKmCobrancaCliente  Decimal  @default(0) @db.Decimal(12, 4)
  valorKmComissaoMotorista Decimal @default(0) @db.Decimal(12, 4)
  percentualComissao      Decimal? @db.Decimal(5, 2)

  ativa                   Boolean  @default(true)

  carregamentos           Carregamento[]

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([companyId, codigo])
}

model Motorista {
  id                 String       @id @default(cuid())
  companyId          String
  company            Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  nome               String
  cpf                String?
  cnh                String?
  cnhCategoria       String?
  cnhValidade        DateTime?
  telefone           String?
  email              String?
  portalSenha        String?

  tipoComissao       TipoComissao @default(POR_KM)
  valorComissaoKm    Decimal?     @db.Decimal(12, 4)
  percentualComissao Decimal?     @db.Decimal(5, 2)

  ativo              Boolean      @default(true)

  carregamentos      CarregamentoMotorista[]
  lancamentos        LancamentoFinanceiro[]
  fotosCarga         CarregamentoFoto[]
  pushSubscriptions  PushSubscription[]

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([companyId, cpf])
}

model Veiculo {
  id                   String      @id @default(cuid())
  companyId            String
  company              Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  placa                String
  renavam              String?
  modelo               String?
  marca                String?
  ano                  Int?
  tipo                 TipoVeiculo @default(CAMINHAO)

  codigoCentroCusto    String?
  descricaoCentroCusto String?

  ativo                Boolean     @default(true)

  carregamentos        CarregamentoVeiculo[]
  lancamentos          LancamentoFinanceiro[]

  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@unique([companyId, placa])
}

enum CarregamentoStatus {
  RASCUNHO
  PLANEJADO
  EMBARCADO
  EM_TRANSITO
  DESEMBARCADO
  FINALIZADO
  CANCELADO
}

model Carregamento {
  id                      String             @id @default(cuid())
  companyId               String
  company                 Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  numero                  String

  /// Número da minuta / ordem de coleta (documento manual no embarque)
  numeroMinuta            String?
  minutaFotoPath          String?
  minutaFotoNome          String?

  /// GTA — Guia de Trânsito Animal (registro manual)
  numeroGta               String?
  gtaUf                   String?            @db.Char(2)

  status                  CarregamentoStatus @default(RASCUNHO)

  clienteOrigemId         String
  clienteOrigem           Cliente            @relation("CarregamentoOrigem", fields: [clienteOrigemId], references: [id])
  clienteDestinoId        String
  clienteDestino          Cliente            @relation("CarregamentoDestino", fields: [clienteDestinoId], references: [id])

  rotaId                  String?
  rota                    Rota?              @relation(fields: [rotaId], references: [id])

  dataEmbarque            DateTime?
  dataDesembarque         DateTime?
  dataPrevisaoDesembarque DateTime?

  quantidadeAnimais       Int
  pesoMedioEstimado       Decimal?           @db.Decimal(10, 2)
  pesoTotal               Decimal?           @db.Decimal(12, 2)

  kmRota                  Decimal?           @db.Decimal(10, 2)
  kmReal                  Decimal?           @db.Decimal(10, 2)
  valorCarga              Decimal?           @db.Decimal(14, 2)

  valorFreteCliente       Decimal?           @db.Decimal(14, 2)
  valorComissaoTotal      Decimal?           @db.Decimal(14, 2)
  valorPedagio            Decimal?           @db.Decimal(12, 2)
  valorBalanca            Decimal?           @db.Decimal(12, 2)
  margemBruta             Decimal?           @db.Decimal(14, 2)

  /// Abatimento no frete cobrado do cliente (ex.: perda de carga)
  descontoFreteCliente    Decimal?           @db.Decimal(14, 2)
  motivoDescontoFrete     String?
  /// Após descontos — espelham cobrança e margem real
  valorFreteLiquido       Decimal?           @db.Decimal(14, 2)
  /// Cobrança total líquida ao cliente (frete + outros − abatimentos), dos lançamentos
  valorReceitaLiquida     Decimal?           @db.Decimal(14, 2)
  valorComissaoLiquida    Decimal?           @db.Decimal(14, 2)
  margemLiquida           Decimal?           @db.Decimal(14, 2)

  /// Despesas de viagem (CC motorista) — diesel, pedágio pago pelo motorista, etc.
  custoDespesasViagem     Decimal?           @db.Decimal(14, 2)
  /// CC veículo pago direto pela empresa neste embarque (sem espelho motorista)
  custoVeiculoDireto      Decimal?           @db.Decimal(14, 2)
  /// Receita − comissão − despesas viagem − custo veículo direto
  margemOperacional       Decimal?           @db.Decimal(14, 2)

  /// Financeiro da viagem fechado (apuração + CC motorista + cobrança)
  financeiroFechadoAt     DateTime?

  observacoes             String?

  nfeChave                String?
  nfeNumero               String?
  nfeSerie                String?
  nfeValor                Decimal?           @db.Decimal(14, 2)
  nfeEmitenteCnpj         String?
  nfeDestinatarioCnpj     String?
  nfeXmlHash              String?
  nfeDataEmissao          DateTime?
  nfeProdutoDescricao     String?

  motoristas              CarregamentoMotorista[]
  veiculos                CarregamentoVeiculo[]
  eventos                 CarregamentoEvento[]
  notasFiscais            CarregamentoNotaFiscal[]
  lancamentos             LancamentoFinanceiro[]
  fotos                   CarregamentoFoto[]

  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@unique([companyId, numero])
  @@index([companyId, status])
  @@index([companyId, dataEmbarque])
}

enum NotaFiscalPapel {
  PRINCIPAL
  TROCA
}

model CarregamentoNotaFiscal {
  id                  String       @id @default(cuid())
  companyId           String
  company             Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  carregamentoId      String
  carregamento        Carregamento @relation(fields: [carregamentoId], references: [id], onDelete: Cascade)

  chave               String?
  numero              String
  serie               String?
  valorTotal          Decimal      @db.Decimal(14, 2)
  quantidadeAnimais   Int?
  emitenteCnpj        String?
  emitenteNome        String?
  destinatarioCnpj    String?
  destinatarioNome    String?
  produtoDescricao    String?
  dataEmissao         DateTime?
  xmlHash             String?
  papel               NotaFiscalPapel @default(PRINCIPAL)

  createdAt           DateTime     @default(now())

  @@unique([companyId, xmlHash])
  @@index([carregamentoId])
}

enum CarregamentoEventoTipo {
  CRIADO
  STATUS_ALTERADO
  NFE_IMPORTADA
  EDITADO
}

model CarregamentoEvento {
  id              String                 @id @default(cuid())
  carregamentoId  String
  carregamento    Carregamento           @relation(fields: [carregamentoId], references: [id], onDelete: Cascade)
  tipo            CarregamentoEventoTipo
  titulo          String
  descricao       String?
  statusAnterior  CarregamentoStatus?
  statusNovo      CarregamentoStatus?
  userId          String?
  user            User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  metadata        Json?
  createdAt       DateTime               @default(now())

  @@index([carregamentoId, createdAt])
}

model CarregamentoMotorista {
  id                 String       @id @default(cuid())
  carregamentoId     String
  carregamento       Carregamento @relation(fields: [carregamentoId], references: [id], onDelete: Cascade)
  motoristaId        String
  motorista          Motorista    @relation(fields: [motoristaId], references: [id])
  principal          Boolean      @default(false)
  percentualComissao Decimal?     @db.Decimal(5, 2)
  /// Penalidade / desconto na comissão deste motorista nesta viagem
  descontoComissao   Decimal?     @db.Decimal(14, 2)
  motivoDescontoComissao String?

  @@unique([carregamentoId, motoristaId])
}

model CarregamentoVeiculo {
  id             String       @id @default(cuid())
  carregamentoId String
  carregamento   Carregamento @relation(fields: [carregamentoId], references: [id], onDelete: Cascade)
  veiculoId      String
  veiculo        Veiculo      @relation(fields: [veiculoId], references: [id])
  principal      Boolean      @default(true)

  @@unique([carregamentoId, veiculoId])
}

enum CarregamentoFotoMomento {
  EMBARQUE
  TRANSITO
  DESCARGA
  OUTROS
}

/// Fotos operacionais da carga / animais (app motorista + ops)
model CarregamentoFoto {
  id             String                   @id @default(cuid())
  companyId      String
  company        Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  carregamentoId String
  carregamento   Carregamento             @relation(fields: [carregamentoId], references: [id], onDelete: Cascade)
  motoristaId    String?
  motorista      Motorista?               @relation(fields: [motoristaId], references: [id], onDelete: SetNull)

  momento        CarregamentoFotoMomento  @default(EMBARQUE)
  path           String
  nome           String
  observacao     String?

  createdAt      DateTime                 @default(now())

  @@index([carregamentoId, createdAt])
  @@index([companyId, carregamentoId])
}

/// Web Push / Expo push do app motorista
model PushSubscription {
  id          String     @id @default(cuid())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  motoristaId String
  motorista   Motorista  @relation(fields: [motoristaId], references: [id], onDelete: Cascade)

  endpoint    String
  p256dh      String
  auth        String
  userAgent   String?

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([endpoint])
  @@index([motoristaId])
  @@index([companyId, motoristaId])
}

// ============ FINANCEIRO — Ledger unificado ============

enum LancamentoTipo {
  ADIANTAMENTO
  DESPESA_MOTORISTA
  REEMBOLSO_MOTORISTA
  PRESTACAO_CONTAS
  COMISSAO_MOTORISTA
  DESCONTO_COMISSAO_MOTORISTA
  ACERTO_MOTORISTA
  FRETE_CLIENTE
  ABATIMENTO_FRETE_CLIENTE
  PEDAGIO_CLIENTE
  BALANCA_CLIENTE
  OUTROS_CLIENTE
  COMBUSTIVEL
  MANUTENCAO
  PNEU
  SEGURO
  IPVA_LICENCIAMENTO
  MULTA
  DEPRECIACAO
  OUTROS_VEICULO
  RECEITA
  DESPESA
  TRANSFERENCIA
}

enum LancamentoNatureza {
  CREDITO
  DEBITO
}

enum LancamentoStatus {
  PENDENTE
  CONFIRMADO
  CANCELADO
  ESTORNADO
}

model LancamentoFinanceiro {
  id               String             @id @default(cuid())
  companyId        String
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  tipo             LancamentoTipo
  natureza         LancamentoNatureza
  status           LancamentoStatus   @default(PENDENTE)

  valor            Decimal            @db.Decimal(14, 2)
  dataLancamento   DateTime           @default(now())
  dataCompetencia  DateTime
  descricao        String

  carregamentoId   String?
  carregamento     Carregamento?      @relation(fields: [carregamentoId], references: [id], onDelete: SetNull)
  motoristaId      String?
  motorista        Motorista?         @relation(fields: [motoristaId], references: [id], onDelete: SetNull)
  clienteId        String?
  cliente          Cliente?           @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  veiculoId        String?
  veiculo          Veiculo?           @relation(fields: [veiculoId], references: [id], onDelete: SetNull)

  comprovantePath  String?
  comprovanteNome  String?
  apenasLancamento Boolean            @default(false)
  observacoes      String?
  criadoPorId      String?
  criadoPor        User?              @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([companyId, tipo])
  @@index([companyId, motoristaId])
  @@index([companyId, veiculoId])
  @@index([companyId, clienteId])
  @@index([companyId, carregamentoId])
  @@index([companyId, dataCompetencia])
  @@index([companyId, status])
}

// ============ AUDITORIA ============

model Log {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  module    String
  action    String
  detail    String?
  ip        String?
  createdAt DateTime @default(now())
}
