{
  "name": "atlas-boi-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "node ../scripts/ensure-port-free.mjs 3004 && nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "node --require ts-node/register --test src/common/utils/nota-fiscal-aggregate.spec.ts src/modules/financeiro/financeiro-liquidos.spec.ts src/common/utils/documents.spec.ts src/modules/intelligence/query-brain.patterns.spec.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:reset-operacional": "ts-node prisma/reset-operacional.ts",
    "mobile:start": "npm run start --prefix ../mobile",
    "mobile:android": "npm run android --prefix ../mobile",
    "mobile:build:apk": "npm exec --prefix ../mobile eas build -p android --profile preview",
    "mobile:build:aab": "npm exec --prefix ../mobile eas build -p android --profile production"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@prisma/client": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.4.0",
    "fast-xml-parser": "^5.8.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "tesseract.js": "^7.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/passport-jwt": "^4.0.0",
    "@types/pg": "^8.20.0",
    "@types/web-push": "^3.6.4",
    "prisma": "^5.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  }
}
